# Copiar para .env SOMENTE na VPS, fora do Git. Gere uma senha hexadecimal.
POSTGRES_PASSWORD=
ALLOWED_ORIGINS=https://SEU-APP.netlify.app
API_PORT=8310
# Compilação local: variável de ambiente opcional para preencher a URL pública da API.
LEADCAPS_API_URL=
# Configurar somente na VPS com deploy/configure_anthropic.py.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_WORKSPACE_ID=
CONTENT_DAILY_LIMIT=20
# Pesquisa automática: janela Windows com -Service Serper (serper.dev).
SEARCH_PROVIDER=serper
SERPER_API_KEY=
# Alternativa independente: -Service SerpAPI (serpapi.com).
SERPAPI_API_KEY=
SEARCH_MONTHLY_LIMIT=200
SEARCH_HOURLY_LIMIT=40
