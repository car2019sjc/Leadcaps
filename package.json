{
  "name": "leadcaps",
  "version": "0.2.0",
  "private": true,
  "description": "Console de prospecção da OnSet e base para inteligência de conteúdo",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --demo",
    "build:local": "node scripts/build.mjs --private-data",
    "import:html": "node scripts/import-html.mjs",
    "start": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui-bases.mjs",
    "api": "node backend/server.mjs",
    "db:migrate": "node backend/db.mjs",
    "validate": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
